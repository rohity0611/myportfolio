{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Registry",
  "description": "Machine-readable registry of agent capabilities for the OpenCode Factory",
  "type": "object",
  "required": ["version", "lastUpdated", "agents"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "agents": {
      "type": "array",
      "description": "List of registered agents",
      "items": {
        "type": "object",
        "required": ["name", "capabilities", "triggerConditions"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique agent name"
          },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of agent capabilities"
          },
          "triggerConditions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Keywords that should trigger this agent"
          },
          "inputFormat": {
            "type": "string",
            "description": "Expected input format"
          },
          "outputFormat": {
            "type": "string",
            "description": "Expected output format"
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Agents that must run before this one"
          },
          "conflictsWith": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Agents that cannot run concurrently"
          },
          "maxConcurrent": {
            "type": "number",
            "description": "Maximum concurrent instances"
          }
        }
      }
    }
  }
}
